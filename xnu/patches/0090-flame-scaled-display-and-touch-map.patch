+/*
+ * flame: nearest-neighbour shrink of one layer. (dx,dy,w,h) is the layer's
+ * rectangle in logical 1125x2436 coordinates, (sx,sy) its origin in the
+ * surface. Only the panel pixels the rectangle covers are written.
+ */
+void
+AppleCLCD::presentScaled(SweetSurface *s, int32_t sx, int32_t sy, int32_t dx, int32_t dy, int32_t w, int32_t h)
+{
+	uintptr_t src = s->kernelAddress();
+	uint32_t bpe = s->bytesPerElement ? s->bytesPerElement : 4;
+
+	if (src == 0 || bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1 || s->memory == NULL) {
+		return;
+	}
+	if (w <= 0 || h <= 0) {
+		w = (int32_t)s->width;
+		h = (int32_t)s->height;
+	}
+	if (sx < 0 || sy < 0) {
+		sx = sy = 0;
+	}
+	if (dx < 0 || dy < 0) {
+		dx = dy = 0;
+	}
+	if (w > (int32_t)s->width - sx) {
+		w = (int32_t)s->width - sx;
+	}
+	if (h > (int32_t)s->height - sy) {
+		h = (int32_t)s->height - sy;
+	}
+	if (w > (int32_t)fLogicalW - dx) {
+		w = (int32_t)fLogicalW - dx;
+	}
+	if (h > (int32_t)fLogicalH - dy) {
+		h = (int32_t)fLogicalH - dy;
+	}
+	if (w <= 0 || h <= 0) {
+		return;
+	}
+	uint64_t len = s->memory->getLength();
+	/* panel rectangle covered by the logical one */
+	int32_t px0 = dx * FLAME_SCALE_NUM / FLAME_SCALE_DEN;
+	int32_t px1 = ((dx + w) * FLAME_SCALE_NUM + FLAME_SCALE_DEN - 1) / FLAME_SCALE_DEN;
+	int32_t py0 = dy * FLAME_SCALE_NUM / FLAME_SCALE_DEN;
+	int32_t py1 = ((dy + h) * FLAME_SCALE_NUM + FLAME_SCALE_DEN - 1) / FLAME_SCALE_DEN;
+	if (px1 > (int32_t)fWidth) {
+		px1 = (int32_t)fWidth;
+	}
+	if (py1 + fBarY > (int32_t)fHeight) {
+		py1 = (int32_t)fHeight - fBarY;
+	}
+	for (int32_t py = py0; py < py1; py++) {
+		int32_t ly = (py * FLAME_SCALE_DEN + FLAME_SCALE_DEN / 2) / FLAME_SCALE_NUM;	/* centre sample */
+		if (ly < dy || ly >= dy + h) {
+			continue;
+		}
+		uint64_t srow = (uint64_t)s->offset + (uint64_t)(sy + ly - dy) * s->bytesPerRow;
+		if (srow + (uint64_t)(sx + w) * 4 > len) {
+			break;
+		}
+		const uint32_t *in = (const uint32_t *)(src + srow);
+		uint32_t *out = (uint32_t *)(fPixels + (uint64_t)(py + fBarY) * fRowBytes);
+		for (int32_t px = px0; px < px1; px++) {
+			int32_t lx = (px * FLAME_SCALE_DEN + FLAME_SCALE_DEN / 2) / FLAME_SCALE_NUM;
+			if (lx < dx || lx >= dx + w) {
+				continue;
+			}
+			out[px] = in[sx + lx - dx];
+		}
+	}
+}
